# ═══════════════════════════════════════════════════════════════
# Turnkey WireGuard & Tailscale Stack - Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Your public IP or Dynamic DNS domain (DuckDNS, Cloudflare, No-IP)
WG_HOST=myhome.duckdns.org

# WireGuard-Easy Web UI Admin Password (change immediately)
WG_PASSWORD=SuperSecretPass!2026

# Tailscale Re-usable Auth Key (from https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-kXXXXX-XXXXXXXXXXXXX

# Your Local Home LAN Subnet to expose to your Tailscale mesh
TS_LAN_SUBNET=192.168.1.0/24

# Optional: Telegram Alerts for WAN IP change & VPN tunnel drops
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
